# llm-council settings. Copy to .env (chmod 600). Real environment variables win over .env.
# All model calls go through Mese; llm-council holds no provider key. See README.md "Configure llm-council".

# Mese inference API. With Mese on the DGX Spark: the Spark's tailnet IPv4 (`tailscale ip -4` there)
# or its MagicDNS name. With Mese on this machine: http://127.0.0.1:8790 (the default).
MESE_URL=http://<spark-tailnet-ipv4>:8790

# Mese client token (mese_ck_…), from ~/.mese/tokens/llm-council.token on the Mese host. Never commit it.
# Copy it from the Spark without printing it (README.md shows the exact command), e.g.
#   token="$(ssh spark 'cat ~/.mese/tokens/llm-council.token')" && …
MESE_API_KEY=

# Mese admin panel, linked from the UI. With Mese on the Spark it works while
#   ssh -N -L 8791:127.0.0.1:8791 spark
# is open.
MESE_ADMIN_URL=http://127.0.0.1:8791/admin/

# Backend bind. The backend has NO authentication and spends money through Mese, and the default
# 0.0.0.0 listens on every interface, LAN included (README.md "Exposure"). To narrow it, set this
# Mac's tailnet IPv4 and open the UI as http://<that IP>:5173, or 127.0.0.1 for this Mac only.
# COUNCIL_HOST=0.0.0.0
# COUNCIL_PORT=8001

# Optional
# TITLE_MODEL=
# DEFAULT_COUNCIL=
# DEFAULT_CHAIRMAN=
# COUNCIL_ALLOWED_ORIGINS=
# COUNCIL_DATA_DIR=data
# PRESETS_PATH=data/presets.json
