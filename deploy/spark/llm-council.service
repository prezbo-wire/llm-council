# systemd --user unit for the llm-council backend on the DGX Spark.
# deploy/spark/install-user.sh renders it into ~/.config/systemd/user/ with the checkout's real path.

[Unit]
Description=llm-council backend (COUNCIL_HOST:COUNCIL_PORT, a Mese client)
Wants=mese.service
After=mese.service
StartLimitIntervalSec=0

[Service]
Type=exec
WorkingDirectory=%h/Development/llm-council
EnvironmentFile=%h/.config/llm-council/llm-council.env
# MESE_API_KEY, rewritten by install-user.sh from Mese's ~/.mese/tokens/llm-council.token.
EnvironmentFile=%h/.config/llm-council/mese-token.env
Environment=PYTHONUNBUFFERED=1
# Fail closed: an empty or wildcard COUNCIL_HOST would make the unauthenticated backend listen on every
# interface (its built-in default is 0.0.0.0). "$$" reaches sh as "$".
ExecStartPre=/bin/sh -c 'case "$${COUNCIL_HOST:-}" in ""|0.0.0.0|::|"[::]"|"*") echo "llm-council: COUNCIL_HOST must be a specific address, got \"$${COUNCIL_HOST:-}\"" >&2; exit 1;; esac'
ExecStart=%h/Development/llm-council/.venv/bin/python -m backend.main
# The bind fails while tailscale0 has no address yet (boot); retry with backoff instead of giving up.
Restart=on-failure
RestartSec=5
RestartSteps=6
RestartMaxDelaySec=60
KillSignal=SIGTERM
TimeoutStopSec=30
# Conversation files are private to the user.
UMask=0077
NoNewPrivileges=true
SyslogIdentifier=llm-council

[Install]
WantedBy=default.target
