# Environment for deploy/spark/llm-council.service and llm-council-ui.service (systemd EnvironmentFile).
#
# install-user.sh writes ~/.config/llm-council/llm-council.env (0600) from this file once, with the Spark's
# tailnet IPv4, its MagicDNS names and your home directory filled in, and never overwrites it afterwards.
# Edit it there, then run `systemctl --user restart llm-council llm-council-ui`.
#
# Rules for this file:
# - systemd does not expand "~", "$HOME" or "%h" in an EnvironmentFile: use absolute paths.
# - One KEY=value per line, no quotes.
# - No secrets: install-user.sh writes the Mese client token to ~/.config/llm-council/mese-token.env (0600)
#   from Mese's ~/.mese/tokens/llm-council.token on every run.

# Bind address of the backend (COUNCIL_PORT) and of the UI (COUNCIL_UI_PORT). The Spark's tailnet IPv4
# (`tailscale ip -4`), so tailnet devices allowed by your ACL reach them. The backend has NO authentication
# and spends money through Mese: never 0.0.0.0 here (the unit refuses to start with it). Linux also accepts
# packets for this address on the LAN interface, so keep ufw on with these two ports denied (tailnet
# traffic is accepted before ufw); install-user.sh prints the command when ufw is off.
# The placeholder below is rejected until it is replaced.
COUNCIL_HOST=<spark-tailnet-ipv4>
COUNCIL_PORT=8001
COUNCIL_UI_PORT=5173

# Mese on this box: MESE_INFER_HOST and MESE_INFER_PORT from ~/.config/mese/mese.env.
MESE_URL=http://<spark-tailnet-ipv4>:8790

# Linked from the UI. It opens on the machine that has `ssh -N -L 8791:127.0.0.1:8791 <spark>` running.
MESE_ADMIN_URL=http://127.0.0.1:8791/admin/

# Browser origins allowed by CORS, comma separated. Their hostnames are also the backend's Host allowlist
# (a DNS-rebinding guard), so list every name you open the UI by (tailnet IP, MagicDNS short name and
# full name), each on COUNCIL_UI_PORT.
COUNCIL_ALLOWED_ORIGINS=http://<spark-tailnet-ipv4>:5173

# Conversations (<dir>/conversations) and user presets (<dir>/presets.json), kept outside the checkout so
# a deploy never touches them.
COUNCIL_DATA_DIR=<home>/.llm-council

# Optional
# TITLE_MODEL=
# DEFAULT_COUNCIL=
# DEFAULT_CHAIRMAN=
